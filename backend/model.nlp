        "system.faq.0": [
          {
            "answer": "NOVA is an AI-powered HR and employee management system for managing recruitment, payroll, performance, and analytics."
          }
        ],
        "system.faq.1": [
          {
            "answer": "Go to the login page, enter your registered email and password, and click Login."
          }
        ],
        "system.faq.2": [
          {
            "answer": "Click on Register and fill in your name, email, role, and password to create an account."
          }
        ],
        "system.faq.3": [
          {
            "answer": "Click on Forgot Password and follow the instructions sent to your email."
          }
        ],
        "system.faq.4": [
          {
            "answer": "NOVA supports Employee, HR, and Admin roles."
          }
        ],
        "system.faq.5": [
          {
            "answer": "Go to Employee Dashboard → Leave → Apply Leave and submit the request."
          }
        ],
        "system.faq.6": [
          {
            "answer": "Leave requests are approved by HR or the reporting manager."
          }
        ],
        "system.faq.7": [
          {
            "answer": "Open Employee Dashboard → Leave → Leave Balance."
          }
        ],
        "system.faq.8": [
          {
            "answer": "Go to Employee Dashboard → Payroll → Salary Details."
          }
        ],
        "system.faq.9": [
          {
            "answer": "Go to Payroll → Payslip → Download."
          }
        ],
        "system.faq.10": [
          {
            "answer": "Go to Profile → Edit Profile and save changes."
          }
        ],
        "system.faq.11": [
          {
