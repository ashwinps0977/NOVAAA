    "responses": {
      "en": {
        "greeting": [
          {
            "answer": "Hello! I am your AI HR Assistant. I can help with leaves, policies, and your profile."
          },
          {
            "answer": "Hi! How can I assist you with your HR needs today?"
          }
        ],
        "policy.hours": [
          {
            "answer": "Our general working hours are 9:00 AM to 6:00 PM, Monday to Friday."
          }
        ],
        "policy.dress": [
          {
            "answer": "We follow a Business Casual dress code. Formal wear is recommended for client meetings."
          }
        ],
        "policy.holidays": [
          {
            "answer": "The next upcoming holiday is Republic Day on January 26th. You can view the full calendar in the Dashboard."
          }
        ],
        "policy.benefits": [
          {
            "answer": "You are covered under the company Medical Insurance up to $5000. PF contributions are matched at 12%."
          }
        ],
        "smalltalk.thanks": [
          {
            "answer": "You're welcome! Let me know if you need anything else."
          }
        ],
        "smalltalk.bye": [
          {
            "answer": "Goodbye! Have a productive day."
          }
        ],
        "smalltalk.creator": [
          {
            "answer": "I was built by the NOVA Engineering Team to assist you."
          }
        ]
      }
    }
  },
